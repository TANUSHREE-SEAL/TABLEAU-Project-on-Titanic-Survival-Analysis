      <column aggregation='None' caption='Age (bin)' datatype='integer' name='[Age (bin)]' role='dimension' type='ordinal'>
        <calculation class='bin' decimals='0' formula='[age]' peg='0' size='5' />
      </column>
      <column caption='survival status' datatype='string' name='[Calculation_0522020939309056]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [survived]=1 THEN &quot;Survived&quot;&#13;&#10;ELSE &quot;Not Survived&quot;&#13;&#10;END' />
      </column>
      <column caption='survival rate' datatype='real' name='[Calculation_0522020939698177]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([survived])/COUNT([passenger_id])' />
      </column>
      <column caption='age group' datatype='string' name='[Calculation_0522020940058626]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [age] &lt;18 THEN &quot;Child&quot;&#13;&#10;ELSEIF [age] &lt;35 THEN &quot;Young Adult&quot;&#13;&#10;ELSEIF [age] &lt;60 THEN &quot;Adult&quot;&#13;&#10;ELSE &quot;Senior&quot;&#13;&#10;END' />
      </column>
      <column caption='family category' datatype='string' name='[Calculation_0522020940251139]' role='dimension' type='nominal'>
